{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexora.dev/examples/automation-colony/scenario/0.1.0/schema.json",
  "title": "Automation Colony Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["width", "height", "sourceRegeneration", "unitSpawnCost", "controllerProgressBase"],
  "properties": {
    "width": { "type": "integer", "minimum": 4, "maximum": 1024 },
    "height": { "type": "integer", "minimum": 4, "maximum": 1024 },
    "sourceRegeneration": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "unitSpawnCost": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "controllerProgressBase": { "type": "integer", "minimum": 1, "maximum": 1000000 }
  }
}
